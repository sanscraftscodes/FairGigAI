{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "installCommand": "python -m pip install -r requirements-vercel.txt",
      "functions": {
        "backend/vercel_app.py": {
          "includeFiles": "{backend/app/**,backend/vercel_app.py,data/tasks.csv,data/workers.csv,models/cat_model_python.py,models/ensemble_configuration.json,models/hist_gradient_boosting.json,predictions/ensemble_test.csv,predictions/y_test.csv}",
          "excludeFiles": "{backend/tests/**,backend/scripts/**,backend/generate_*.py,backend/app/fairgig.db,models/all_trained_models.joblib,models/cat_model.joblib,models/cat_model.cbm,models/cat_model_debug.json,frontend/**,documentation/**,**/__pycache__/**,**/*.pyc,**/*.md,**/*.docx,**/*.zip,**/*.bat}"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
